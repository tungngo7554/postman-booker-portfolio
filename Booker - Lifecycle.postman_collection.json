      "name": "Auth_Get token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();\npm.environment.set(\"token\", data.token);\n\npm.test(\"Status là 200\", () => {\n  pm.response.to.have.status(200);\n});\n\npm.test(\"Có token\", () => {\n  const data = pm.response.json();\n  pm.expect(data.token).to.be.a(\"string\").and.not.empty;\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
