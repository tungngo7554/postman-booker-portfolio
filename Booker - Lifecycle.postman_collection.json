    {
      "name": "Booking - Create",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();\r\npm.environment.set(\"bookingId\", data.bookingid);\r\n\r\nconst res = pm.response.json();\r\npm.test(\"Dữ liệu trả về khớp dữ liệu gửi\", () => {\r\n  pm.expect(res.booking.firstname).to.eql(pm.variables.get(\"firstName\"));\r\n  pm.expect(res.booking.lastname).to.eql(pm.variables.get(\"lastName\"));\r\n  pm.expect(res.booking.totalprice).to.eql(Number(pm.variables.get(\"price\")));\r\n});\r\npm.environment.set(\"bookingId\", res.bookingid);\r\n// lưu lại để các request sau còn so khớp\r\npm.environment.set(\"savedFirstName\", pm.variables.get(\"firstName\"));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"firstName\", pm.variables.replaceIn(\"{{$randomFirstName}}\"));\r\npm.variables.set(\"lastName\", pm.variables.replaceIn(\"{{$randomLastName}}\"));\r\npm.variables.set(\"price\", _.random(100, 999));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token=6be4cc1aa7e0620"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstname\": \"{{firstName}}\",\r\n  \"lastname\": \"{{lastName}}\",\r\n  \"totalprice\": {{price}},\r\n  \"depositpaid\": true,\r\n  \"bookingdates\": { \"checkin\": \"2026-11-01\", \"checkout\": \"2026-11-05\" },\r\n  \"additionalneeds\": \"Breakfast\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            ""
          ]
        }
      },
      "response": []
    },
